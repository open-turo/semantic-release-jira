{
  "author": "Turo engineering",
  "dependencies": {
    "@octokit/rest": "^22.0.0",
    "axios": "^1.7.9",
    "axios-retry": "^4.5.0",
    "conventional-commits-parser": "^6.0.0",
    "fast-redact": "^3.5.0",
    "p-limit": "^7.2.0",
    "safe-regex": "^2.1.1",
    "zod": "^4.3.5"
  },
  "description": "Semantic Release plugin for JIRA",
  "devDependencies": {
    "@open-turo/eslint-config-typescript": "23.0.10",
    "@types/conventional-commits-parser": "5.0.2",
    "@types/fast-redact": "3.0.4",
    "@types/node": "25.8.0",
    "@types/safe-regex": "1.1.6",
    "@vitest/coverage-v8": "4.1.6",
    "eslint": "9.39.4",
    "nock": "13.5.6",
    "prettier": "3.8.3",
    "rimraf": "6.1.3",
    "semantic-release": "25.0.3",
    "ts-patch": "4.0.1",
    "tsc-watch": "7.2.0",
    "typescript": "6.0.3",
    "typescript-transform-paths": "3.5.6",
    "vitest": "4.1.6"
  },
  "engines": {
    "node": ">= 20.0.0"
  },
  "license": "MIT",
  "main": "lib/index.js",
  "name": "@open-turo/semantic-release-jira",
  "peerDependencies": {
    "semantic-release": ">=23.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tspc -p ./tsconfig.build.json",
    "check-types": "tsc --noemit",
    "clean": "rimraf lib",
    "lint": "eslint ./src ./test eslint.config.mjs && npm run check-types",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch": "npm run clean && tsc-watch -w -p ./tsconfig.build.json --compiler ./node_modules/.bin/tspc"
  },
  "type": "module",
  "types": "lib/index.d.ts",
  "version": "1.0.2",
  "workspaces": [
    "semantic-release"
  ]
}
