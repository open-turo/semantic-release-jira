{
  "author": "Turo engineering",
  "dependencies": {},
  "description": "Semantic Release plugin for JIRA",
  "devDependencies": {
    "@open-turo/eslint-config-typescript": "18.1.24",
    "@types/node": "25.0.3",
    "eslint": "9.39.2",
    "prettier": "3.7.4",
    "rimraf": "6.1.2",
    "ts-patch": "3.3.0",
    "tsc-watch": "7.2.0",
    "typescript": "5.9.3",
    "typescript-transform-paths": "3.5.5",
    "vitest": "4.0.16"
  },
  "engines": {
    "node": ">= 20.0.0"
  },
  "license": "MIT",
  "main": "lib/index.js",
  "name": "@open-turo/semantic-release-jira",
  "private": true,
  "scripts": {
    "build": "tspc -p ./tsconfig.build.json",
    "check-types": "tsc --noemit",
    "clean": "rimraf lib",
    "lint": "eslint && npm run check-types",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch": "npm run clean && tsc-watch -w -p ./tsconfig.build.json --compiler ./node_modules/.bin/tspc"
  },
  "type": "module",
  "types": "lib/index.d.ts",
  "workspaces": [
    "semantic-release"
  ]
}
